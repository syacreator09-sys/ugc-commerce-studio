{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "commerce-review-evidence-v1.schema.json",
  "title": "CommerceReviewEvidenceV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","evidence_id","product_ref","sample_size","positive_themes","negative_themes","recurring_complaints","unmet_needs","quality_expectations","source_refs","provenance","generated_at"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "evidence_id": {"type": "string", "minLength": 1},
    "product_ref": {"type": "string", "minLength": 1},
    "sample_size": {"type": "integer", "minimum": 0},
    "average_rating": {"type": ["number","null"], "minimum": 0, "maximum": 5},
    "positive_themes": {"type": "array", "items": {"type": "string"}},
    "negative_themes": {"type": "array", "items": {"type": "string"}},
    "recurring_complaints": {"type": "array", "items": {"type": "string"}},
    "unmet_needs": {"type": "array", "items": {"type": "string"}},
    "quality_expectations": {"type": "array", "items": {"type": "string"}},
    "source_refs": {"type": "array", "items": {"type": "string"}},
    "provenance": {"type": "array", "items": {"type": "string"}},
    "observed_at": {"type": ["string","null"], "format": "date-time"},
    "generated_at": {"type": "string", "format": "date-time"}
  }
}
